# abba, malayalam are palindromes
s = input('enter the string')
flag = True
for i in range(0, len(s)//2):
    if s[i] != s[len(s) - i - 1]:
        flag = False
        print('Not a Palindrome')
        break
if flag:
    print('Palindrome')








