# union() vs update()
s1 = {1, 2, 3, 4, 5}
s2 = {4, 5, 6, 7, 8}


# union() - Returns new set
print(s1.union(s2))  # {1, 2, 3, 4, 5, 6, 7, 8}
print(s1)  # {1, 2, 3, 4, 5} - unchanged


# update() - Modifies original set
s1.update(s2)
print('After update:', s1)  # {1, 2, 3, 4, 5, 6, 7, 8}


# intersection() vs intersection_update()
s1 = {1, 2, 3, 4, 5}
s2 = {4, 5, 6, 7, 8}


# intersection() - Returns new set
print(s1.intersection(s2))  # {4, 5}
print(s1)  # {1, 2, 3, 4, 5} - unchanged


# intersection_update() - Modifies original
s1.intersection_update(s2)
print('After intersection_update:', s1)  # {4, 5}


# difference() vs difference_update()
s1 = {1, 2, 3, 4, 5}
s2 = {4, 5, 6, 7, 8}


# difference() - Returns new set
print(s1.difference(s2))  # {1, 2, 3}
print(s1)  # {1, 2, 3, 4, 5} - unchanged


# difference_update() - Modifies original
s1.difference_update(s2)
print('After difference_update:', s1)  # {1, 2, 3}


# symmetric_difference() vs symmetric_difference_update()
s1 = {1, 2, 3, 4, 5}
s2 = {4, 5, 6, 7, 8}


# symmetric_difference() - Returns new set
print(s1.symmetric_difference(s2))  # {1, 2, 3, 6, 7, 8}
print(s1)  # {1, 2, 3, 4, 5} - unchanged


# symmetric_difference_update() - Modifies original
s1.symmetric_difference_update(s2)
print('After symmetric_difference_update:', s1)  # {1, 2, 3, 6, 7, 8}


# isdisjoint() - True if no common elements
s1 = {1, 2, 3, 4}
s2 = {7, 8, 5, 6}


print(s1.isdisjoint(s2))  # True


# issubset() / issuperset()
s1 = {1, 2, 3, 4, 5}
s2 = {3, 4, 5}


print(s1.issuperset(s2))  # True (s1 contains all of s2)


# copy() - Create a copy
s1 = {1, 2, 3}
s2 = s1.copy()

print('s1:', s1)  # {1, 2, 3}
print('s2:', s2)  # {1, 2, 3}





