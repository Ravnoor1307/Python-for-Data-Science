


# Input basics — input() hamesha string deta hai

name = input("Apna naam type karo: ")
print("Namaste,", name)

age_str = input("Apni age batao (number): ")
print("Aapne btaya:", age_str, "| type:", type(age_str))

# Expected OUTPUT: console input ke saath varies karta hai — isliye output
# unpredictable hai, par structure kuch aisa hi dikhega






# int(input(...)) — the holy pattern

age = int(input("Apni age likho: "))
birth_year = 2026 - age
print(f"Tum {age} saal ke ho, itna matlab {birth_year} me born hue ho!")

# Expected OUTPUT: input par depend karta hai (age=20 -> born 2006)






# Input + floor division = pocket money calculator

days = int(input("Kitne din ka paisa chahiye? "))
total_rs = int(input("Kitna paisa hai (₹)? "))
per_day = total_rs // days
remaining = total_rs % days
print(f"Roz aapko {per_day} ₹ milega, last me {remaining} ₹ bachega.")
print("Lambi race ka ghoda, paisa apna manage karo! 🐎")

# Expected OUTPUT: days=7, total=500 -> Roz 71 ₹ milega, last me 3 ₹ bachega.






# Mini program: movie ticket counter

name = input("Kiska naam ticket par likhein? ")
tickets = int(input("Kitne tickets? "))
price = float(input("Har ticket ki price (₹): "))

total = tickets * price
print("=" * 35)
print("MOVIE TICKET COUNTER 🎟️")
print(f"Customer  : {name}")
print(f"Tickets   : {tickets} x ₹{price}")
print(f"Total     : ₹{total:.2f}")
print("=" * 35)
print("Enjoy the show,", name, "! 🍿")

# Expected OUTPUT: input par depends karta hai (Rahul, 2, 250.0 -> Total: ₹500.00)




