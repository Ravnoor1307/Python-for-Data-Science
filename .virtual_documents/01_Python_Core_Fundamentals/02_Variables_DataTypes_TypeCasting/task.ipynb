# TODO 1-3: temp swap, then tuple swap



# ✅ SOLUTION — Task 2

a = 21
b = 9

temp = a          # save a's value
a = b             # a takes b's value
b = temp          # b takes the saved old a
print(f"After temp swap: a={a}, b={b}")

a, b = b, a       # back to original using the one-liner
print(f"After tuple swap: a={a}, b={b}")






