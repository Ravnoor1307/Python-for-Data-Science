# TODO 1-3: to_number(), loop with total, final print



# ✅ SOLUTION — Task 5

rows = ["12", "abc", "  7 ", "3.5", "1,000", "99"]

def to_number(text):
    text = text.strip().replace(",", "")
    try:
        return float(text)
    except ValueError:
        return None

total = 0.0
for row in rows:
    value = to_number(row)
    if value is None:
        print("INVALID:", row)
    else:
        total += value
        print("-", value, "(kept)")

print("Total kept:", total)
















