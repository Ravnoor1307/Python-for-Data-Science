


# Basic conversions — int, float, str ke beech jaano
print(int("100"))


print(float("3.5"))


print(str(100) + " rupees")       # now "100" is text


print(float(7))                   # 7 -> 7.0


print(int(3.9))                   # truncates toward zero!





# Simulating the input() trap without interaction —
user_age = "21"                 # as if typed by the user
print(type(user_age))           # string!


age = int(user_age)             # now we can do math
print("Next year you will be:", age + 1)





# Catch ValueError — galat string ko int banana

for value in ["abc", "12.5", "  42  ", "1,000"]:
    try:
        print(f"int({value!r}) =", int(value))
    except ValueError as e:
        print(f"int({value!r}) -> ValueError:", e)





# Truncation vs rounding — pyare zara sa farak

print(int(3.99))        # 3 — decimal cut ho gaya
print(round(3.99))      # 4 — nearest integer
print(int(round(3.99))) # 4 — round phir int


price_float = 499.75
print("Rupees:", int(price_float))          # 499
print("Rupees:", int(round(price_float)))   # 500





# bool() surprises — text sab truthy hota hai except empty

print(bool(0), bool(-1), bool(3.5))
print(bool(""), bool("False"), bool("0"))
print(bool([]), bool([0]))





# Safe parser — bina crash kiye user input check karo

def to_int(text):
    try:
        return int(text)
    except ValueError:
        return None

for raw in ["21", "oops", "  7 "]:
    value = to_int(raw)
    if value is None:
        print(f"{raw!r} -> invalid number")
    else:
        print(f"{raw!r} -> {value} (type {type(value).__name__})")







