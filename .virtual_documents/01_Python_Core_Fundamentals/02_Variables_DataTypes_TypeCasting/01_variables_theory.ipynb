





# Creating variables — value creation aur label chhodo

student_name = "Priya"
roll_no = 42
marks = 91
passed = True

print(student_name)
print(roll_no, marks, passed)





# Dynamic typing — same label, different types over time

data = 10
print(data, type(data))


data = 10.5
print(data, type(data))


data = "ten and a half"
print(data, type(data))





# Multiple assignment aur swap trick — ek line me kaam khatam

a, b, c = 10, 20, 30
print(a, b, c)


left = "coffee"
right = "milk"
left, right = right, left     # swap in one line!
print(left, right)





# References — b = a does NOT copy; it points to the same value

a = 5
b = a
print("a id:", id(a), "| b id:", id(b), "-> same:", id(a) == id(b))


a = 100
print("after a = 100:")
print("a =", a, "| b =", b)          # b still holds 5
print("a id:", id(a), "| b id:", id(b))





# Catch a NameError safely — label bina value, kaam nahi karega

try:
    print(total_marks)
except NameError as e:
    print("NameError ->", e)

total_marks = 88          # now the label exists
print("Now it works:", total_marks)


# The "swap with one temporary" classic, written our way
x = 21
y = 9


temp = x      # keep x's value safe
x = y         # x takes y's value
y = temp      # y takes the saved old value of x
print("x =", x, "| y =", y)






