


# type() — value ko poochho ki tum kaun ho
print(type(42))


print(type(3.14))


print(type("hi"))


print(type(True))





# Integer math — quotient, remainder, power

a = 7
b = 2

print(a + b)       # 9
print(a / b)       # 3.5  (always float)
print(a // b)      # 3    (floor quotient)
print(a % b)       # 1    (remainder)
print(a ** b)      # 49


# parity check is a classic use of modulo
number = 8
print("even?", number % 2 == 0)


# Python integers — chhote-bade sab ko handle karta hai

big = 2 ** 100
print(big)





# Floating point — thoda gol gol, par fix aasaan hai

total = 0.1 + 0.2
print(total)                       # the surprise!


print(round(total, 2))             # cleaned up for display


price = 99.9
print(price * 3)                   # 299.699... 





# Strings — quotes, concat, repeat, len, indexing

first = "Python"
second = 'Rocks'
combined = first + " " + second     # concatenation
print(combined)

print("ha " * 3)                    # repetition
print(len(first))                   # character count
print(first[0], first[-1])          # first and last char


# f-strings — values ko sentence ke andar bithao (minor preview)

player = "Virat"
runs = 183
print(f"{player} scored {runs} runs!")





# Truthiness — 0 aur empty = False, baaki sab = True

print(bool(1), bool(0))
print(bool("hi"), bool(""))
print(bool([1]), bool([]))

user_input = ""
if not user_input:
    print("Empty input detected!")


# Comparisons return booleans — samjho kaise banta hai True

print(5 > 3)          # True
print(5 == 5)         # True
print(5 != 5)         # False
print("apple" in "pineapple")    # True

age = 17
print(age >= 18)      # False — not adult yet





# Catch a TypeError safely — "5" + 3 wala scene

try:
    print("5" + 3)
except TypeError as e:
    print("TypeError ->", e)
    print("But after converting:", int("5") + 3)






