





# Naming conventions — snake_case, PascalCase, UPPER_CASE

monthly_salary = 45000          # variable -> snake_case
TAX_RATE = 0.10                 # constant  -> UPPER_CASE

def calculate_tax(salary):      # function  -> snake_case
    return salary * TAX_RATE

print(calculate_tax(monthly_salary))





# Whitespace rules in action

price = 1200            # spaces around = 
tax   = 0.18

total = price + tax * price          # spaces around operators
items = ["apple", "mango"]           # space after commas

print(total)
print(items[0])                      # no space inside brackets





