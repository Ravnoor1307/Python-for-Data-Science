# Import style — stdlib, then local/third-party, one per line
import math
import os


PI = round(math.pi, 2)
print(PI)
print(os.name)


# A cleaner import: only what you need
from math import sqrt
print(sqrt(16))





# Pythonic comparisons — is None, not items, direct loops

cart = []                     # empty list -> falsy

if not cart:
    print("Cart is empty, add something!")

fruits = ["mango", "apple", "banana"]
if fruits:                    # non-empty -> truthy
    print("We have", len(fruits), "fruits")

# direct iteration instead of range(len(...))
for fruit in fruits:
    print(" -", fruit)





# Why-comments + a small docstring example

DAILY_LIMIT = 5000

def convert_currency(amount, rate):
    """Return amount after converting at the given rate."""
    return round(amount * rate, 2)


usd = 200
inr = convert_currency(usd, 83.5)      # KISS rule: keep it simple
print(f"${usd} = ₹{inr}")





# A tiny taste: checking rules your own way
# (KISS — manually verify "snake_case" in a known-standard way)

good_names = ["total_marks", "calculate_average", "student_record"]
for name in good_names:
    print(name, "-> looks snake_case:", name.islower())






