





# The Zen of Python — Python ke andar chhupi hui guidance 🌌
import this

# Python prints its own design philosophy as a poem.





# Statement vs Expression — ek hi cell me dono dekho

greeting = "Namaste"                 # STATEMENT: creates a variable
print(greeting)                      # STATEMENT: prints to the screen

greeting + " from India"             # EXPRESSION: computes a new value

result = greeting + ", Rahul Sharma" # STATEMENT containing an EXPRESSION
print(result)





# Indentation in action — if ke andar vs if ke bahar

marks = 65                      # try changing 65 to 30 and run again

if marks >= 40:                 # ← don't forget the colon !
    print("Pass! 🎉")           # 4 spaces in — runs only when True
    print("Party time!")

print("This line always runs")  # 0 spaces — outside the block


# Nested indentation — block ke andar block (Level 2)

age = 21
has_id = True                   # try setting False and run again

if age >= 18:                   # Level 1
    if has_id:                  # Level 2 starts here (8 spaces zone)
        print("Welcome to the club 🎟️")
    else:
        print("Show your ID first 😅")
else:
    print("Sorry, 18+ only 🚫")





# Grades with if-elif-else — multi-condition ka pura scene

marks = 78

if marks >= 90:
    grade = "A+"
elif marks >= 75:
    grade = "A"
elif marks >= 60:
    grade = "B"
elif marks >= 40:
    grade = "C"
else:
    grade = "Fail"

print(f"Marks: {marks}/100 → Grade: {grade}")





# Python hai case-sensitive

name = "Rahul"
Name = "Priya"          # this is a DIFFERENT variable, not a typo

print(name)             # lowercase 'n'
print(Name)             # uppercase 'N'


print(NAME)





# Comments in action — humans ke liye notes, Python ignore karta hai

price = 1500            # price in rupees
discount = 0.10         # 10% offer

final = price * (1 - discount)   # this line is the real logic
print(final)                     # prints the discounted price





import keyword

print("Total keywords:", len(keyword.kwlist))
keyword.kwlist


# Check whether a word is reserved or free to use:
print(keyword.iskeyword("class"))   # True — reserved
print(keyword.iskeyword("name"))    # False — you can use it





# Catching an IndentationError safely — error se darna nahi, padhna seekho

broken_code = """
if True:
print("This line should be indented!")
"""

try:
    compile(broken_code, "<my_code>", "exec")
    print("All good!")
except IndentationError as e:
    print("Error type :", type(e).__name__)
    print("Line no    :", e.lineno)
    print("Message    :", e.msg)






